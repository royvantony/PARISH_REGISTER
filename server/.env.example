# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:password@localhost:5432/parish_register?schema=public"

# Express API Port
PORT=5000

# Runtime Environment ("development" | "production")
NODE_ENV="production"

# Unique Random 64-Hex Secrets (Generate two separate secrets before first setup!)
# Example (PowerShell / Node): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-random-64-char-hex-jwt-secret"
FEATURE_VAULT_KEY="replace-with-separate-random-64-char-hex-vault-key"

# Keep "false" (or remove) in production / public demo builds
ALLOW_DEV_LOGIN="false"

# Optional fallback SMTP settings (if not configured per parish in Settings -> Email & SMTP)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM_EMAIL=""
# SMTP_FROM_NAME="Parish Register"

